{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: analyze AAPL",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "console": "integratedTerminal",
      "args": [
        "--ticker",
        "AAPL",
        "--company",
        "Apple",
        "--market",
        "US",
        "--provider",
        "huggingface"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Streamlit: run app",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py",
        "--server.port",
        "8501"
      ],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}