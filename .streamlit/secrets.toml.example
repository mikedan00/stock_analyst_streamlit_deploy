# Streamlit Cloud > App > Settings > Secrets 에 아래 내용을 붙여넣으세요.
# GitHub에 실제 secrets.toml 파일을 커밋하지 마세요.

DEFAULT_PROVIDER = "huggingface"
APP_ENABLE_DATA_COLLECTOR = true
STREAMLIT_DEPLOY_MODE = "cloud"
# 공개 배포에서 LLM API 비용을 보호하려면 설정하세요. 비우면 앱은 공개됩니다.
APP_PASSWORD = "change-this-password"

# Hugging Face Inference API / Router
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
HF_MODEL = "google/gemma-4-26B-A4B-it"

# Anthropic
ANTHROPIC_API_KEY = "sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL = "claude-sonnet-4-20250514"
ANTHROPIC_ENABLE_WEB_SEARCH = false

# OpenAI-compatible API
OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-4o-mini"
